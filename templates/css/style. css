* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --primary: #4f46e5;
    --primary-dark: #3730a3;
    --secondary: #7c3aed;
    --dark: #111827;
    --text: #374151;
    --muted: #6b7280;
    --light: #f8fafc;
    --white: #ffffff;
    --border: #e5e7eb;
    --success: #16a34a;
    --danger: #dc2626;
    --warning: #d97706;
    --shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
}

html {
    scroll-behavior: smooth;
}

body {
    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    color: var(--text);
    background: var(--light);
    line-height: 1.6;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input,
textarea,
select {
    font: inherit;
}

button {
    cursor: pointer;
}

.container {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
}


/* NAVBAR */

.navbar {
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 1000;
    backdrop-filter: blur(10px);
}

.nav-container {
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 23px;
    font-weight: 800;
    color: var(--dark);
}

.logo-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--primary);
    color: white;
    font-weight: 800;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
}

.nav-links a {
    color: var(--muted);
    font-size: 14px;
    font-weight: 600;
    transition: 0.2s;
}

.nav-links a:hover,
.nav-links a.active {
    color: var(--primary);
}

.nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}


/* BUTTONS */

.btn {
    border: none;
    border-radius: 10px;
    padding: 11px 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    transition: 0.2s;
}

.btn-primary {
    background: var(--primary);
    color: white;
}

.btn-primary:hover {
    background: var(--primary-dark);
    transform: translateY(-1px);
}

.btn-outline {
    background: white;
    border: 1px solid var(--border);
    color: var(--dark);
}

.btn-outline:hover {
    border-color: var(--primary);
    color: var(--primary);
}

.btn-light {
    background: white;
    color: var(--primary);
}

.btn-large {
    padding: 14px 25px;
    font-size: 15px;
}

.btn-full {
    width: 100%;
}


/* HERO */

.hero {
    background:
        radial-gradient(
            circle at 80% 20%,
            rgba(124, 58, 237, 0.3),
            transparent 30%
        ),
        linear-gradient(
            135deg,
            #111827,
            #312e81
        );

    color: white;
    padding: 90px 0 110px;
}

.hero-container {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 70px;
}

.hero-badge {
    display: inline-block;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.15);
    padding: 8px 14px;
    border-radius: 50px;
    font-size: 13px;
    margin-bottom: 22px;
}

.hero h1 {
    font-size: clamp(42px, 6vw, 68px);
    line-height: 1.05;
    letter-spacing: -2px;
    margin-bottom: 25px;
}

.hero h1 span {
    display: block;
    color: #a5b4fc;
}

.hero-content > p {
    max-width: 590px;
    font-size: 18px;
    color: #d1d5db;
}

.hero-buttons {
    display: flex;
    gap: 12px;
    margin-top: 32px;
}

.hero-stats {
    display: flex;
    gap: 45px;
    margin-top: 50px;
}

.hero-stats div {
    display: flex;
    flex-direction: column;
}

.hero-stats strong {
    font-size: 25px;
}

.hero-stats span {
    color: #cbd5e1;
    font-size: 13px;
}


/* HERO CARD */

.hero-card {
    position: relative;
    min-height: 430px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.hero-main-card {
    width: 320px;
    padding: 45px 30px;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 25px;
    text-align: center;
    backdrop-filter: blur(15px);
}

.profile-circle {
    width: 90px;
    height: 90px;
    margin: 0 auto 20px;
    border-radius: 50%;
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 45px;
}

.hero-main-card h3 {
    font-size: 24px;
    margin-bottom: 10px;
}

.hero-main-card p {
    color: #d1d5db;
}

.progress-line {
    height: 8px;
    border-radius: 10px;
    background: rgba(255,255,255,0.15);
    margin: 25px 0 8px;
    overflow: hidden;
}

.progress-line span {
    display: block;
    width: 92%;
    height: 100%;
    background: #a5b4fc;
}

.floating-card {
    position: absolute;
    padding: 14px;
    background: white;
    color: var(--dark);
    border-radius: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.2);
}

.floating-card strong,
.floating-card small {
    display: block;
}

.floating-card strong {
    font-size: 13px;
}

.floating-card small {
    color: var(--muted);
    font-size: 11px;
}

.card-one {
    top: 50px;
    left: 0;
}

.card-two {
    right: 0;
    bottom: 50px;
}

.icon-box,
.success-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: #eef2ff;
    display: flex;
    align-items: center;
    justify-content: center;
}

.success-icon {
    background: #dcfce7;
    color: var(--success);
    font-weight: bold;
}


/* SEARCH */

.search-section {
    margin-top: -45px;
    position: relative;
    z-index: 10;
}

.search-box {
    background: white;
    border-radius: 16px;
    box-shadow: var(--shadow);
    padding: 15px;
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 10px;
}

.search-field {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 15px;
    border: 1px solid var(--border);
    border-radius: 10px;
}

.search-field input {
    border: none;
    outline: none;
    width: 100%;
    padding: 13px 0;
}


/* SECTIONS */

.section {
    padding: 80px 0;
}

.section-heading {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 45px;
}

.section-label {
    display: inline-block;
    color: var(--primary);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    margin-bottom: 10px;
}

.section-heading h2 {
    color: var(--dark);
    font-size: 36px;
    line-height: 1.2;
    margin-bottom: 12px;
}

.section-heading p {
    color: var(--muted);
}


/* FEATURES */

.feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.feature-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 30px;
    transition: 0.25s;
}

.feature-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
}

.feature-icon {
    width: 55px;
    height: 55px;
    border-radius: 14px;
    background: #eef2ff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 25px;
    margin-bottom: 20px;
}

.feature-card h3 {
    color: var(--dark);
    margin-bottom: 10px;
}

.feature-card p {
    color: var(--muted);
    margin-bottom: 20px;
}

.feature-card a {
    color: var(--primary);
    font-weight: 700;
    font-size: 14px;
}


/* LOGIN */

.login-section {
    padding: 90px 0;
    background: #eef2ff;
}

.login-container {
    display: grid;
    grid-template-columns: 1fr 450px;
    align-items: center;
    gap: 80px;
}

.login-info h2 {
    font-size: 45px;
    color: var(--dark);
    line-height: 1.1;
    margin-bottom: 18px;
}

.login-info p {
    color: var(--muted);
    max-width: 500px;
}


/* AUTH CARD */

.auth-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 35px;
    box-shadow: var(--shadow);
}

.auth-card h2 {
    color: var(--dark);
    font-size: 28px;
}

.auth-subtitle {
    color: var(--muted);
    margin-bottom: 25px;
}

.auth-heading {
    text-align: center;
    margin-bottom: 30px;
}

.auth-heading h1 {
    color: var(--dark);
    font-size: 28px;
    margin: 12px 0 5px;
}

.auth-heading p {
    color: var(--muted);
}

.auth-logo {
    width: 55px;
    height: 55px;
    margin: auto;
    background: var(--primary);
    color: white;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 25px;
    font-weight: bold;
}

.auth-wrapper {
    min-height: calc(100vh - 77px);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 50px 20px;
}

.register-card {
    width: min(600px, 100%);
}

.auth-footer {
    margin-top: 20px;
    text-align: center;
    color: var(--muted);
    font-size: 14px;
}

.auth-footer a {
    color: var(--primary);
    font-weight: 700;
}

.back-link {
    color: var(--muted);
    font-size: 14px;
    font-weight: 600;
}


/* FORMS */

.form-group {
    margin-bottom: 18px;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.form-group label {
    display: block;
    margin-bottom: 7px;
    color: var(--dark);
    font-size: 13px;
    font-weight: 700;
}

.form-group input,
.form-group textarea,
.form-group select {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 13px;
    outline: none;
    background: white;
    color: var(--dark);
}

.form-group textarea {
    resize: vertical;
}

.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(79,70,229,0.1);
}


/* MESSAGE */

.message {
    margin-top: 15px;
    font-size: 13px;
}

.message.success {
    color: var(--success);
}

.message.error {
    color: var(--danger);
}


/* PAGE HEADER */

.page-header {
    padding: 65px 0;
    background:
        linear-gradient(
            135deg,
            #eef2ff,
            #faf5ff
        );
}

.page-header h1 {
    color: var(--dark);
    font-size: 42px;
    margin-bottom: 10px;
}

.page-header p {
    color: var(--muted);
}


/* JOB SEARCH */

.job-search {
    background: white;
    border: 1px solid var(--border);
    border-radius: 15px;
    padding: 15px;
    display: grid;
    grid-template-columns: 1fr 1fr 180px auto;
    gap: 10px;
    margin-bottom: 30px;
}

.job-search input,
.job-search select {
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 12px;
    outline: none;
}


/* JOBS */

.jobs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.job-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 25px;
    transition: 0.2s;
}

.job-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
}

.job-card h3 {
    color: var(--dark);
    margin-bottom: 8px;
}

.job-company {
    color: var(--primary);
    font-weight: 700;
    font-size: 14px;
}

.job-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 17px 0;
}

.job-tag {
    padding: 5px 9px;
    background: #f1f5f9;
    border-radius: 6px;
    font-size: 11px;
    color: var(--muted);
}

.job-description {
    color: var(--muted);
    font-size: 14px;
    margin-bottom: 20px;
}

.job-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
}


/* DASHBOARD */

.dashboard-header {
    padding: 55px 0;
    background: linear-gradient(135deg, #eef2ff, #faf5ff);
}

.dashboard-header h1 {
    font-size: 40px;
    color: var(--dark);
}

.dashboard-header h1 span {
    color: var(--primary);
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 30px;
}

.stat-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 15px;
    padding: 22px;
    display: flex;
    align-items: center;
    gap: 15px;
}

.stat-icon {
    width: 48px;
    height: 48px;
    background: #eef2ff;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
}

.stat-card span,
.stat-card strong {
    display: block;
}

.stat-card span {
    color: var(--muted);
    font-size: 12px;
}

.stat-card strong {
    color: var(--dark);
    font-size: 25px;
}

.dashboard-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.dashboard-card,
.company-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 25px;
}

.card-header {
    margin-bottom: 25px;
}

.card-header h3 {
    color: var(--dark);
}

.card-header p {
    color: var(--muted);
    font-size: 13px;
}

.quick-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.quick-action {
    border: 1px solid var(--border);
    padding: 18px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 700;
    transition: 0.2s;
}

.quick-action:hover {
    border-color: var(--primary);
    color: var(--primary);
}


/* APPLICATIONS */

.applications-list,
.interviews-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.application-card,
.interview-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 15px;
    padding: 22px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
}

.status-badge {
    display: inline-block;
    padding: 6px 10px;
    border-radius: 20px;
    background: #eef2ff;
    color: var(--primary);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
}


/* JOB DETAIL */

.job-detail-card {
    background: white;
    border-radius: 20px;
    border: 1px solid var(--border);
    padding: 40px;
}

.job-detail-header {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 30px;
}

.job-detail-card h1 {
    color: var(--dark);
    font-size: 36px;
}

.job-detail-section {
    margin-top: 30px;
}

.job-detail-section h3 {
    color: var(--dark);
    margin-bottom: 10px;
}

.job-detail-section p {
    color: var(--muted);
    white-space: pre-line;
}


/* LOADING */

.loading {
    background: white;
    border: 1px solid var(--border);
    border-radius: 15px;
    padding: 40px;
    text-align: center;
    color: var(--muted);
}


/* FOOTER */

.footer {
    background: #111827;
    color: #d1d5db;
    padding-top: 50px;
}

.footer-container {
    display: flex;
    justify-content: space-between;
    gap: 30px;
    padding-bottom: 40px;
}

.footer-logo {
    color: white;
}

.footer-links {
    display: flex;
    gap: 25px;
}

.footer-links a:hover {
    color: white;
}

.footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.1);
    text-align: center;
    padding: 20px;
    font-size: 13px;
}


/* RESPONSIVE */

@media (max-width: 900px) {

    .hero-container,
    .login-container,
    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .hero-card {
        display: none;
    }

    .feature-grid,
    .jobs-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .job-search {
        grid-template-columns: 1fr 1fr;
    }

    .search-box {
        grid-template-columns: 1fr;
    }

}

@media (max-width: 650px) {

    .container {
        width: min(100% - 25px, 1180px);
    }

    .nav-links {
        display: none;
    }

    .nav-actions .btn-outline {
        display: none;
    }

    .hero {
        padding: 60px 0 80px;
    }

    .hero h1 {
        font-size: 42px;
    }

    .hero-buttons {
        flex-direction: column;
    }

    .hero-stats {
        gap: 25px;
    }

    .feature-grid,
    .jobs-grid,
    .stats-grid,
    .form-row,
    .job-search {
        grid-template-columns: 1fr;
    }

    .application-card,
    .interview-card,
    .job-detail-header,
    .footer-container {
        flex-direction: column;
    }

    .footer-links {
        flex-direction: column;
        gap: 10px;
    }

}